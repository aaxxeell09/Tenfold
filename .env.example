# live app (all optional: without them the app runs untraced with fallback phrases)
WANDB_API_KEY=            # Weave tracing of events; also used by lesson/tutor.py (W&B Inference)
WANDB_ENTITY=
WANDB_INFERENCE_BASE_URL=
WANDB_INFERENCE_PROJECT=  # entity/project that W&B Inference usage is billed and shown under
# loop (required to run loop/critic.py)
ANTHROPIC_API_KEY=        # Claude Code headless critic (the patch agent, and every agent unless the next line says wandb)
TENFOLD_TEXT_AGENTS=      # claude (default) or wandb: diagnostic and guard agents on W&B Inference, served on CoreWeave
TENFOLD_TEXT_AGENT_MODEL= # default Qwen/Qwen3-235B-A22B-Instruct-2507
WANDB_API_KEY_HELDOUT=    # a second account's key (Axel's); never in the critic's environment
WANDB_ENTITY_HELDOUT=     # that account's entity, owns the tenfold-heldout project
# critic model backend (pick one):
#   a) nothing here and `claude login` on this machine (Claude subscription)
#   b) ANTHROPIC_API_KEY=            an Anthropic API key with credit
#   c) an Anthropic-compatible provider, e.g. DeepSeek:
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=               the provider key
# ANTHROPIC_AUTH_TOKEN=            same key (the CLI needs both)
# ANTHROPIC_MODEL=deepseek-chat
# ANTHROPIC_SMALL_FAST_MODEL=deepseek-chat
# With b) or c) the critic runs the CLI in its own config dir (.claude-critic/, gitignored).
# critic model backend (pick one):
#   a) nothing here and `claude login` on this machine (Claude subscription)
#   b) ANTHROPIC_API_KEY=sk-ant-...      an API key with credit; the critic then runs the CLI in its own
#      config dir (.claude-critic/, gitignored). An org-level key also needs:
#      ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: wrkspc_..."
